{
  "version": 2,
  "builds": [
    {
      "src": "apps/server/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "apps/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/server/api/index.js"
    },
    {
      "src": "/health",
      "dest": "apps/server/api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "apps/client/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|json|woff|woff2|ttf|eot))",
      "dest": "apps/client/$1"
    },
    {
      "src": "/(.*)",
      "dest": "apps/client/index.html"
    }
  ]
}
