{
  "buildCommand": "cd apps/client && npm run build",
  "outputDirectory": "apps/client/dist",
  "functions": {
    "apps/server/api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/apps/server/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/apps/server/api/index.js"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/index.html"
    }
  ]
}
