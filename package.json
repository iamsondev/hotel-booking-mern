{
  "name": "hotel-booking-monorepo",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev --workspaces --parallel",
    "dev:client": "npm run dev -w apps/client",
    "dev:server": "npm run dev -w apps/server",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w apps/server"
  },
  "workspaces": [
    "apps/server",
    "apps/client"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
